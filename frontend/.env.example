# Firebase-Konfiguration (Projekteinstellungen -> "Web-App" in der Firebase Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Diese E-Mail-Adresse wird beim ersten Login automatisch als Admin freigeschaltet
# (damit die Person, die das System einrichtet, sich nicht selbst aussperrt).
VITE_INITIAL_ADMIN_EMAIL=

# Push-Benachrichtigung bei neuen Registrierungen ueber ntfy.sh (kostenlos,
# kein Account noetig). Einfach einen eigenen, moeglichst einzigartigen
# Topic-Namen ausdenken (z.B. "kickbase-ligasystem-xyz123-admin") und hier
# eintragen. Danach in der ntfy-App (iOS/Android) oder unter
# https://ntfy.sh/<dein-topic> im Browser genau dieses Topic abonnieren.
VITE_NTFY_TOPIC=

# Native Push-Benachrichtigungen (Firebase Cloud Messaging), funktioniert auch
# fuer die als PWA auf dem iPhone-Homescreen installierte App (ab iOS 16.4).
# Oeffentlicher Schluessel aus: Firebase Console -> Projekteinstellungen ->
# Cloud Messaging -> Web-Konfiguration -> "Zertifikate fuer Web-Push" ->
# Schluesselpaar generieren.
VITE_FIREBASE_VAPID_KEY=

# NUR in Vercel setzen (nicht hier, kein VITE_-Praefix -> bleibt serverseitig):
# FIREBASE_SERVICE_ACCOUNT_KEY = kompletter Inhalt der Service-Account-JSON aus
# Firebase Console -> Projekteinstellungen -> Dienstkonten -> "Neuen privaten
# Schluessel generieren", als ein-zeiliger String eingefuegt.
