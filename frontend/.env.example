# Firebase-Konfiguration (Projekteinstellungen -> "Web-App" in der Firebase Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Diese E-Mail-Adresse wird beim ersten Login automatisch als Admin freigeschaltet
# (damit die Person, die das System einrichtet, sich nicht selbst aussperrt).
VITE_INITIAL_ADMIN_EMAIL=
