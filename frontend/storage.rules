rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profilbilder: jede*r darf nur das eigene Avatar-Bild hochladen/ändern,
    // aber alle eingeloggten Nutzer duerfen Avatare lesen (werden z.B. in der
    // Nutzerverwaltung/Kader-Ansichten angezeigt). Max. 5 MB, nur Bilder.
    match /avatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
