rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isApproved() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // WICHTIG: Trage hier die E-Mail-Adresse der Person ein, die das System einrichtet.
    // Nur mit GENAU dieser (verifizierten!) E-Mail-Adresse darf sich beim allerersten
    // Login direkt selbst als Admin freischalten. Google-Login liefert eine verifizierte
    // E-Mail automatisch - bei Email/Passwort-Login muss die Adresse erst per
    // Firebase "E-Mail-Verifizierung" bestätigt werden, sonst greift dieser Bootstrap nicht.
    function isVerifiedInitialAdmin() {
      return isSignedIn() &&
        request.auth.token.email == "weinrich99@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      // Jede*r darf das eigene Profil lesen, Admins dürfen alle lesen.
      allow read: if isSelf(userId) || isAdmin();

      // Anlegen des eigenen Profils beim ersten Login:
      // - Normalfall: IMMER als 'pending' / 'user' (kein Selbst-Freischalten möglich).
      // - Ausnahme: die exakte, verifizierte Initial-Admin-Mail darf sich direkt
      //   als 'approved' / 'admin' anlegen (einmaliger Bootstrap fürs Setup).
      allow create: if isSelf(userId) && (
        (request.resource.data.status == 'pending' && request.resource.data.role == 'user') ||
        (isVerifiedInitialAdmin() && request.resource.data.status == 'approved' && request.resource.data.role == 'admin')
      );

      // Normale Nutzer dürfen ihr eigenes Profil aktualisieren (z.B. FCM-Token für
      // Push-Erinnerungen setzen) - aber NICHT ihre eigene role/status ändern
      // (kein Selbst-Freischalten). Nur Admins dürfen role/status ändern.
      //
      // Der Kickbase-Name darf nur EINMAL frei gewählt werden (kickbaseId noch
      // nicht gesetzt). Ist er schon gesetzt, kann ein Nutzer ihn nicht mehr
      // selbst ändern - nur noch eine Änderung ÜBER kickbaseChangeRequest
      // beantragen, die ein Admin bestätigen oder ablehnen muss.
      allow update: if isAdmin() || (
        isSelf(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        (
          !('kickbaseId' in resource.data) || resource.data.kickbaseId == null ||
          (
            request.resource.data.kickbaseId == resource.data.kickbaseId &&
            request.resource.data.kickbaseName == resource.data.kickbaseName
          )
        )
      );

      allow delete: if isAdmin();
    }

    // Das Regelwerk ist öffentlich lesbar für eingeloggte Nutzer, Änderungen
    // bleiben ausschließlich Admins vorbehalten.
    match /settings/rules {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Artikel-Interaktionen: Aggregat-Zähler (Gesehen, Reaktionen, Kommentare).
    // Normale Manager sehen hierüber ausschließlich Zählerzahlen (keine Leser-Namen).
    match /articles/{slug} {
      allow read: if isApproved();
      allow create, update: if isApproved();
      allow delete: if isAdmin();

      // Eindeutige Artikel-Aufrufe: NUR der eigene View-Eintrag oder Admins
      // dürfen lesen ("nur Zahl für gelesen" auch auf Datenbank-Ebene erzwungen).
      match /views/{userId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create, update: if isApproved() && isSelf(userId);
        allow delete: if isAdmin();
      }

      // Artikel-Kommentare: alle freigegebenen Manager dürfen lesen & kommentieren;
      // Bearbeiten nur durch den Autor, Löschen durch Autor oder Admin.
      match /comments/{commentId} {
        allow read: if isApproved();
        allow create: if isApproved() &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 1000;
        allow update: if isApproved() &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 1000;
        allow delete: if isAdmin() || (isApproved() && resource.data.uid == request.auth.uid);
      }

      // Emoji-Reaktionen pro Nutzer (Dokument-ID = uid)
      match /reactions/{userId} {
        allow read: if isApproved();
        allow create, update, delete: if isApproved() && isSelf(userId);
      }
    }

    // Tägliche App-Nutzungsstatistiken (DAU, Bereichs-Aufrufe, Plattformen):
    // Schreiben durch alle freigegebenen Manager (atomare Zähler), Lesen NUR Admins.
    match /analytics_daily/{dateKey} {
      allow read: if isAdmin();
      allow create, update: if isApproved();
      allow delete: if isAdmin();
    }
  }
}
