# Kickbase-Zugang für das neue, unabhängige Ligasystem (Saison 26/27)
# Ein einziger Account, der Mitglied in allen 3 Ligen ist.
KICKBASE_EMAIL=
KICKBASE_PASS=

# Optionale weitere Accounts (KICKBASE_EMAIL_2/_3/_4 + zugehöriges PASS), falls
# Ligen/Wettbewerbe auf unterschiedliche Kickbase-Logins verteilt sind. Jeder
# Fetch-Lauf probiert automatisch ALLE konfigurierten Accounts durch (siehe
# getConfiguredKickbaseAccounts in backend/kickbase.js), bis einer passt -
# keine feste Zuordnung "Account X = Liga Y" nötig.
# _4 ist für den separaten Pokal-Account reserviert.
KICKBASE_EMAIL_2=
KICKBASE_PASS_2=
KICKBASE_EMAIL_3=
KICKBASE_PASS_3=
KICKBASE_EMAIL_4=
KICKBASE_PASS_4=

# Namen der 3 Ligen exakt so, wie sie in der Kickbase-App heißen.
# (Optional - Standardwerte sind "Liga 1" / "Liga 2" / "Liga 3")
KICKBASE_LEAGUE_1_NAME=Liga 1
KICKBASE_LEAGUE_2_NAME=Liga 2
KICKBASE_LEAGUE_3_NAME=Liga 3

# Name der Kickbase-Liga "Arena", in der ALLE Pokal-Teilnehmer gemeinsam stehen -
# wird von backend/scripts/fetch-pokal-arena.js genutzt, um nach jedem
# Pokal-Spieltag automatisch die Duelle auszuwerten (siehe update-pokal-results.yml).
# (Optional - Standardwert ist "Arena")
KICKBASE_LEAGUE_ARENA_NAME=Arena

# Wird von backend/fetchOptimalTeam.js genutzt, um Spieler-/Marktdaten zu laden.
# Kann auf eine der 3 Ligen oben zeigen (der Spieler-Pool ist ligaübergreifend identisch).
KICKBASE_LEAGUE=Liga 1

# Secret für den manuellen "Update"-Button im Frontend (Vercel Cron Trigger)
CRON_SECRET=
GITHUB_TOKEN=
